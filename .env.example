# =============================================================================
# SchoolLogs — Module « Passage »
# Fichier d'exemple de configuration (.env.example)
#
# Copier ce fichier en `.env` puis adapter les valeurs localement.
# IMPORTANT (SEC-09) : ne jamais versionner `.env` ni placer de vrai secret ici.
# =============================================================================

# --- Socle Django ------------------------------------------------------------
# Générer une clé locale avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Hors DEBUG=1, l'application refuse de démarrer si la valeur par défaut est conservée.
SECRET_KEY=remplacer-par-une-cle-aleatoire-de-50-caracteres-minimum
# 1 en développement local uniquement ; 0 obligatoire hors développement (SEC-11)
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Base de données (SQLite par défaut, PostgreSQL optionnel) ---------------
# Valeurs autorisées : sqlite | postgresql
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
# Délai d'attente sur les verrous SQLite en secondes (serveur web + planificateur)
SQLITE_TIMEOUT_SECONDS=20

# Paramètres PostgreSQL (utilisés uniquement si DB_ENGINE=postgresql ; requiert psycopg)
# DB_NAME=schoollogs_passage
# DB_USER=passage_user
# DB_PASSWORD=remplacer-par-mot-de-passe-local
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Badges numériques rotatifs ----------------------------------------------
# Durée de vie d'un code de badge (en secondes) — défaut : 30
PAS_CODE=30
# Écart de pas accepté autour de l'heure retenue (en nombre de pas) — défaut : 1
TOLERANCE_PAS=1
# Validité d'un lien d'activation à usage unique (en heures) — défaut : 24
DUREE_LIEN_ACTIVATION=24

# --- Détection des anomalies et horloge --------------------------------------
# Délai après la fin d'une fenêtre avant de déclarer POINT_MANQUANT (en minutes) — défaut : 10
DELAI_GRACE=10
# Fréquence d'exécution du planificateur en boucle (en secondes) — défaut : 60
PERIODE_PLANIFICATEUR=60
# Seuil de détection d'un double scan sur le même badge (en secondes) — défaut : 60
INTERVALLE_DOUBLE_SCAN=60
# Écart horloge au-delà duquel un lot est marqué « horloge suspecte » (en minutes) — défaut : 5
SEUIL_HORLOGE=5
# Âge maximal au-delà duquel une heure corrigée est jugée aberrante (en jours) — défaut : 7
AGE_MAX_PASSAGE=7

# --- Notifications sortantes -------------------------------------------------
# Nombre maximal de messages émis par élève et par jour — défaut : 3
PLAFOND_MESSAGES=3

# --- Authentification et sessions --------------------------------------------
# Nombre maximal d'échecs de connexion avant blocage — défaut : 5
MAX_TENTATIVES=5
# Fenêtre de comptage des échecs de connexion (en minutes) — défaut : 15
FENETRE_TENTATIVES=15
# Durée du blocage après dépassement des tentatives (en minutes) — défaut : 15
DUREE_BLOCAGE=15
# Durée de vie maximale d'une session serveur (en heures) — défaut : 8
DUREE_SESSION=8

# --- Synthèse assistée par IA (mode dégradé si clé vide) ---------------------
# Nombre maximal d'appels au modèle par jour — défaut : 20
PLAFOND_APPELS_IA_JOUR=20
# Coût estimé maximal par jour (en USD) — défaut : 0.50
PLAFOND_COUT_IA_JOUR=0.50
# Clé API du service de modèle de langage. Laisser vide pour le mode dégradé (gabarit).
CLE_API_IA=
# Modèle IA, délai maximal (s) et grille tarifaire estimée (USD par million de jetons)
IA_MODELE=gemini-2.5-flash
IA_TIMEOUT_SECONDS=10
IA_TARIF_ENTREE_1M=0.15
IA_TARIF_SORTIE_1M=0.60

# --- Outil de démonstration --------------------------------------------------
# Active le banc de démonstration multi-badges (0 = désactivé par défaut, 1 = activé)
DEMO_MODE=0
